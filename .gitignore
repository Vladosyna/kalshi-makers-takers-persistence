.venv/
__pycache__/
*.pyc
.pytest_cache/
# `data/*` (not `data/`) deliberately -- a bare directory-ignore prunes the
# whole tree during traversal, so file-level negations below would never
# even be evaluated (git's documented gotcha: "it is not possible to
# re-include a file if a parent directory of that file is excluded"). The
# glob form ignores each entry individually, which negation can override.
data/*
!data/.gitkeep
!data/logs/
data/logs/*
!data/logs/.gitkeep
# Versioned, pre-registration-relevant artifacts -- committed deliberately,
# same tier as reports/step_zero/ below. Everything else under data/
# (kmt.db, raw fetch output, parquet snapshots, the HF bootstrap download)
# stays gitignored: runtime state and large binary data, not source.
!data/fees.yaml
!data/frozen_2024_mix.json
!data/category_map_polymarket_kalshi.yaml
# Operational config for tools/autostart_fetch.ps1 -- which command the restart
# task runs, and its kill switch. Committed because it is the task's real
# definition; the state file it writes beside it
# (data/autostart_fetch.state.json, holding the last launch time for the
# crash-loop brake) is runtime state and stays ignored.
!data/autostart_fetch.json
# data/pooled_panel.parquet stays ignored: it is a 16MB derived cache of the
# two-hour ASOF build, regenerable by tools/run_event_study.py --rebuild, and
# large binary derivatives do not belong in the history.
reports/*
!reports/.gitkeep
!reports/step_zero/
!reports/r1/
!reports/r2/
!reports/final/
.env

# LaTeX auxiliary output. The PDF under reports/final/ is committed deliberately
# -- it is the artifact that gets submitted -- but the fifteen files pdflatex
# writes beside it are build scratch. tools/build_paper_pdf.py compiles in a
# temporary directory for exactly this reason; these patterns catch the case
# where someone runs pdflatex by hand in the source directory.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.spl
*.synctex.gz
*.toc
reports/final/*.log
